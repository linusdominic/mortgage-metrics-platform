# Copy to .env if you want to override defaults. Nothing here is required for
# `make pipeline`; there are no secrets in the default path.

# Scope from config/pipeline.yml: demo (default), fixture, full
MMP_SCOPE=demo

# Where raw files, Parquet, the DuckDB warehouse, telemetry and logs go
# MMP_DATA_DIR=./data

# http (default) or fixture (offline, reads tests/fixtures/source)
# MMP_SOURCE_MODE=http

# Override the HTTP User-Agent. Unset = the HTTP library's stock identifier.
# Do not put personal contact details here.
# MMP_USER_AGENT=

# Serving guardrails (MCP server and `mmp query`)
# MMP_DEFAULT_ROWS=100
# MMP_MAX_ROWS=1000
# MMP_QUERY_TIMEOUT_S=15
# MMP_MIN_CELL_SIZE=10

# DuckDB memory cap used by dbt
# MMP_DUCKDB_MEMORY_LIMIT=1GB

# Only for `make eval-llm`. The deterministic evals need no key.
# ANTHROPIC_API_KEY=
# MMP_EVAL_MODEL=claude-sonnet-5-5

# docker/airflow/docker-compose.yml (local verification only)
# AIRFLOW_JWT_SECRET=
# AIRFLOW_FERNET_KEY=
# MMP_RETRY_DELAY_SECONDS=120
# MMP_RUN_BUDGET_MINUTES=90
